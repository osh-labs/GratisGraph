# Auto detect text files and perform LF normalization
* text=auto

# Byte-compared fixtures: never let line-ending conversion touch them.
# The desktop bench package and job files are compared byte for byte on Windows too.
desktop/bench/** text eol=lf
*.ggj text eol=lf
desktop/library/** text eol=lf
*.m20 binary
*.SPL binary
*.bin binary
*.gc text eol=lf

# Append-only decision log: parallel branches merge without conflict
desktop/docs/decisions.md merge=union
