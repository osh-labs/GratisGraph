{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/osh-labs/GratisGraph/desktop/job.schema.json",
  "title": "gratisgraph-job v1 (draft until M4)",
  "type": "object",
  "required": ["format", "version", "units", "part", "operations"],
  "properties": {
    "format": {"const": "gratisgraph-job"},
    "version": {"const": 1},
    "units": {"const": "mm"},
    "part": {"type": "string", "minLength": 1},
    "quantity": {"type": "integer", "minimum": 1},
    "reference": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}},
      "additionalProperties": false
    },
    "chord_tolerance_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.01},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "additionalProperties": true,
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "ring": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 3},
    "polyline": {
      "type": "object",
      "required": ["points"],
      "properties": {
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 2},
        "closed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["outer"],
      "properties": {
        "outer": {"$ref": "#/$defs/ring"},
        "holes": {"type": "array", "items": {"$ref": "#/$defs/ring"}}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"enum": ["trace", "fill"]},
        "mode_hint": {"type": "string"},
        "char_height_mm": {"type": "number", "exclusiveMinimum": 0}
      },
      "if": {"properties": {"op": {"const": "trace"}}},
      "then": {
        "required": ["paths"],
        "properties": {"paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/polyline"}}}
      },
      "else": {
        "required": ["regions"],
        "properties": {"regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}}}
      },
      "additionalProperties": true
    }
  }
}
